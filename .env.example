# ==============================================================================
# PANTAL HOTSPOT, JAGA HUTAN DAN GAMBUT - CONFIGURATION TEMPLATE
# ==============================================================================
# PERINGATAN KEAMANAN:
# 1. Salin file ini menjadi '.env' (jangan commit file .env asli ke repository).
# 2. Credential FIRMS_MAP_KEY hanya boleh berada di backend/server side.
# 3. DILARANG mengekspos FIRMS_MAP_KEY ke browser/frontend bundle.
# ==============================================================================

# NASA FIRMS Area API Map Key (Dapatkan gratis di https://firms.modaps.eosdis.nasa.gov/api/map_key)
# Kosongkan atau biarkan dummy jika ingin menguji fallback snapshot.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Sensor / Produk FIRMS
# PRD: Suomi-NPP (VNP14IMGTDL_NRT) akan dihentikan 1 Nov 2026.
# Gunakan NOAA-20 (VJ114IMGTDL_NRT) atau NOAA-21 (VJ214IMGTDL_NRT).
FIRMS_DEFAULT_SOURCE=VIIRS_NOAA20_NRT
FIRMS_BACKUP_SOURCE=VIIRS_NOAA21_NRT

# Bounding Box Indonesia (Format NASA: min_lon,min_lat,max_lon,max_lat)
FIRMS_AREA_BBOX=95.0,-11.0,141.5,6.0

# Timeout permintaan HTTP ke NASA FIRMS (detik)
FIRMS_REQUEST_TIMEOUT_SECONDS=20

# Direktori Data & Geometri
DATA_DIR=data
BOUNDARIES_PATH=data/boundaries/indonesia_provinces.geojson
SNAPSHOTS_DIR=data/snapshots

# Status Mode (set 'true' jika ingin memaksa mode snapshot tanpa menghubungi API)
FORCE_SNAPSHOT_MODE=true

# ==============================================================================
# HANSEN GLOBAL FOREST CHANGE (GFC) RASTER CONFIGURATIONS
# ==============================================================================
HANSEN_DATASET_VERSION=GFC-2025-v1.13
HANSEN_TILES_DIR=data/raster/hansen
# Matikan akses remote global untuk performa optimal (gunakan tile lokal)
HANSEN_ENABLE_REMOTE_ACCESS=false
# Batas waktu tunggu akses remote (detik) per layer untuk mencegah hang
HANSEN_REMOTE_TIMEOUT_SECONDS=3.0
HANSEN_MAX_PARALLEL_WORKERS=3
HANSEN_CACHE_MAX_ENTRIES=10000

# ==============================================================================
# DATABASE & AUTHENTICATION (NEON POSTGRESQL / DEPLOYMENT)
# ==============================================================================
# Kosongkan DATABASE_URL untuk memakai SQLite lokal (data/citizen_reports.db),
# atau isi dengan connection string PostgreSQL (Neon / Railway / Render):
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-this-secret-key-in-production
CORS_ORIGINS=*


# ==============================================================================
# ALERT TELEGRAM (hotspot prediktif per radius lokasi pengguna)
# ==============================================================================
# Buat bot lewat @BotFather. Token hanya boleh di backend, jangan di-commit.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
ALERTS_ENABLED=true
# true = pesan hanya ditulis ke log, tidak dikirim ke Telegram
ALERTS_DRY_RUN=false
ALERTS_MAX_LOCATIONS=5
# Interval (menit) pemeriksaan hotspot prediktif baru. Alert dikirim saat ada hotspot SEDANG/TINGGI baru, tanpa jam tetap.
ALERTS_CHECK_INTERVAL_MINUTES=15
