# Konfigurasi Database (PostgreSQL + PostGIS)
POSTGRES_DB=karhutla_db
POSTGRES_USER=karhutla_user
POSTGRES_PASSWORD=karhutla_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://karhutla_user:karhutla_password@localhost:5432/karhutla_db

# Konfigurasi Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# NASA FIRMS API Configuration (Simpan MAP_KEY hanya di server)
# Dapatkan free MAP_KEY di https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
DEFAULT_SENSOR=VIIRS_NOAA20_NRT

# Jalur Berkas Snapshot Fallback (Benchmark JOINTS 2026)
SNAPSHOT_FALLBACK_PATH=./data/snapshots/joints_benchmark_7days.csv
